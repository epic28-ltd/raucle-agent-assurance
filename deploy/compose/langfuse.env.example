# Langfuse v4.74.0 self-host env — copy to langfuse.env and fill in locally.
# NEVER commit langfuse.env. Placeholder values below are examples.
NEXTAUTH_URL=http://127.0.0.1:3301
NEXTAUTH_SECRET=generate-a-secure-random-secret
SALT=generate-a-secure-random-salt
ENCRYPTION_KEY=generate-a-secure-random-encryption-key
REDIS_AUTH=generate-a-secure-random-redis-auth
MINIO_ROOT_PASSWORD=generate-a-secure-random-minio-pass
POSTGRES_PASSWORD=generate-a-secure-random-postgres-pass
LANGFUSE_INIT_ORG_ID=oaa-org
LANGFUSE_INIT_ORG_NAME=Open Agent Assurance
LANGFUSE_INIT_PROJECT_ID=oaa-project
LANGFUSE_INIT_PROJECT_NAME=oaa-reference-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=fill-from-langfuse-ui
LANGFUSE_INIT_PROJECT_SECRET_KEY=fill-from-langfuse-ui
LANGFUSE_INIT_USER_EMAIL=admin@example.invalid
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=generate-a-secure-random-admin-pass