# OPS-01 reference deployment env template — copy to .env and fill in real values locally.
# install.sh generates .env with random secrets automatically; NEVER commit the real .env
# (install.sh also emits .env into the install dir, which stays out of git — see README).
# ⚠ DEPLOYMENT GATE: LANGFUSE_MIGRATION_V4_WRITE_MODE is hard-pinned to `dual` in
#   docker-compose.yml (ADR-0003). Do not add an override in .env — recheck this
#   gate after every Langfuse version bump (ops/runbook.md §6.5).

# ---- host binding ports (defaults match deploy/compose; override on collision) ----
OAA_WEB_PORT=3301
OAA_EVIDENCE_PORT=3302
OAA_CH_HTTP_PORT=18123
OAA_CH_NATIVE_PORT=19000

# ---- Langfuse secrets (REAL values generated by install.sh) ----
NEXTAUTH_URL=http://127.0.0.1:3301
NEXTAUTH_SECRET=<random-64-hex>
SALT=<random-64-hex>
ENCRYPTION_KEY=<random-64-hex>
REDIS_AUTH=<random-hex>
MINIO_ROOT_PASSWORD=<random-hex>
POSTGRES_PASSWORD=<random-hex>

# ---- Langfuse first-run project provisioning (LANGFUSE_INIT_*) ----
LANGFUSE_INIT_ORG_ID=oaa-org
LANGFUSE_INIT_ORG_NAME=Open Agent Assurance
LANGFUSE_INIT_PROJECT_ID=oaa-project
LANGFUSE_INIT_PROJECT_NAME=oaa-reference-agent
# API keys: fixed by install.sh to generated random pk-lf-/sk-lf- values so the
# producer env (.env) and the project keys are provisioned in one step.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<pk-lf-...>
LANGFUSE_INIT_PROJECT_SECRET_KEY=<sk-lf-...>
LANGFUSE_INIT_USER_EMAIL=admin@example.invalid
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=<random-admin-password>

# ---- producer (reference agent) — placeholders only, NO real secrets committed ----
OAA_LF_URL=http://127.0.0.1:3301
OAA_LF_PUBLIC_KEY=<pk-lf-...>
OAA_LF_SECRET_KEY=<sk-lf-...>
# OTLP endpoint: direct-to-Langfuse by default (see README for collector option)
OAA_OTLP_ENDPOINT=http://127.0.0.1:3301/api/public/otel/v1/traces
OAA_EVIDENCE_URL=http://127.0.0.1:3302

# ---- secret handling rules (repeated from runbook §7) ----
# - .env, obs.env and any *.pem are git-ignored and NEVER committed.
# - This template carries placeholders only; real values live on the host install dir.
# - Lost values are unrecoverable for ENCRYPTION_KEY/SALT (data unreadable) — back .env up
#   to a host-only location outside the repo if you need reproducibility.